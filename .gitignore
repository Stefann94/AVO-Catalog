# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# sablonul fara secrete trebuie sa ramana in git, altfel nimeni nu stie ce variabile cere aplicatia
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arhiva plugin-ului WordPress, generata din fisierul .php din acelasi folder
tools/wordpress/*.zip
