# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# sablonul fara secrete trebuie sa ramana in git, altfel nimeni nu stie ce variabile cere aplicatia
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arhiva plugin-ului WordPress, generata din fisierul .php din acelasi folder
tools/wordpress/*.zip

# jurnalul serverului de dezvoltare
.dev.log

# tools/wordpress/incarca-poze.js
# Credentialele stau in tools/wordpress/.env.local, prins deja de `.env*` de
# mai sus. Sablonul fara secrete e singurul care are voie in repo.
!tools/wordpress/.env.local.exemplu
tools/wordpress/incarca-poze-stare.json
tools/wordpress/incarca-poze-jurnal.txt
tools/wordpress/raport-poze.txt
tools/wordpress/raport-poze.json
tools/wordpress/leaga-poze-stare.json
tools/wordpress/leaga-poze-jurnal.txt
tools/wordpress/cauta-poze-stare.json
tools/wordpress/cauta-poze-jurnal.txt
tools/wordpress/cauta-poze-deye-index.json
tools/wordpress/cauta-poze-deye-jurnal.txt
poze-lipsa.html

# capturi de ecran facute cu tools/captura, pentru verificari vizuale
capturi/
