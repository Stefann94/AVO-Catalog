# Copiază fișierul ăsta ca `.env.local` în același director și completează-l.
# `.env.local` e în .gitignore — parola nu ajunge niciodată în repo.

WP_URL=https://www.avogrupinvest.ro

# Utilizator WordPress cu drept de încărcare în bibliotecă și de editare
# a produselor (Administrator sau Manager magazin).
WP_USER=

# NU parola de logare. E o „parolă de aplicație", generată în WordPress la
#   Utilizatori → Profil → Application Passwords
# Se copiază cu spații cu tot, exact cum o arată WordPress:
#   WP_APP_PASSWORD=abcd EFGH ijkl MNOP qrst UVWX
# Se poate revoca oricând de acolo, separat, fără să schimbi parola de logare.
WP_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Chei WooCommerce, pentru leaga-poze.js
#
# Se fac în WooCommerce → Setări → Avansat → REST API → „Add key", cu
# permisiuni Read/Write. Se arată o singură dată, ca parola de aplicație.
#
# DE CE DOUĂ FELURI DE CREDENȚIALE. Parola de aplicație merge prin antetul
# `Authorization: Basic`, pe care găzduirea acestui site îl blochează (vezi
# diagnostic-acces.js). Cheile de mai jos călătoresc ca parametri în adresă,
# deci trec. Cât timp blocajul e activ, doar ele funcționează.
WC_KEY=
WC_SECRET=
